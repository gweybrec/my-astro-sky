{
  "permissions": {
    "allow": [
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_drop",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_resize",
      "Bash(curl -s http://localhost:5173)",
      "Bash(git stash *)",
      "Skill(run)",
      "Skill(run:*)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(node scripts/*)",
      "Bash(npx electron-forge *)",
      "Bash(npx vite *)",
      "Bash(npx asar *)",
      "Bash(node .claude/hooks/*)",
      "PowerShell(npm run *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npm test 2>&1)",
      "PowerShell(npx tsc 2>&1)",
      "PowerShell(npm run build 2>&1)",
      "Bash(gh pr *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Read(//tmp/**)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch *)",
      "PowerShell(git mv *)",
      "PowerShell(git restore *)",
      "PowerShell(git revert *)",
      "PowerShell(git stash *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git clean *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git reset --hard*)",
      "PowerShell(git push *)",
      "PowerShell(git clean *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git reset --hard*)"
    ],
    "enabledMcpjsonServers": ["playwright"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/prettier-on-edit.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/lint-on-ts-edit.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/vitest-on-ts-edit.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ui-verify-guard.js"
          }
        ]
      }
    ]
  }
}
