<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" stops cloud backup but not phone-to-phone transfer. Nothing is copied either
     way, since the WebView storage holds the key that decrypts the astrometry key kept in the database. Changing
     phones goes through the app's own backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
