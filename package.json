{
  "name": "my-astro-sky",
  "productName": "MyAstroSky",
  "private": true,
  "version": "0.5.0",
  "author": {
    "name": "Guillaume WEYBRECHT",
    "email": "gweybrec.dev@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "predev": "npm rebuild",
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "clean": "node scripts/clean-build.mjs",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "download-catalog": "bash scripts/download-catalog.sh",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "vue-tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-icons": "node scripts/generate-icons.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:preview": "git-cliff --config cliff.toml --unreleased --strip header",
    "electron:make": "npm run clean && npm run build && electron-rebuild && electron-forge make",
    "electron:package": "npm run clean && npm run build && electron-rebuild && electron-forge package",
    "swagger:generate": "node scripts/swagger-docs.mjs",
    "dso:generate": "node scripts/generate-dso.mjs && node scripts/add-constellations.mjs && node scripts/add-ratings.mjs",
    "docs:serve": "docsify serve docs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@testing-library/vue": "^8.1.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@unocss/preset-wind": "^66.7.0",
    "@unocss/vite": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "docsify-cli": "^4.4.4",
    "electron": "^36.9.5",
    "electron-packager": "^16.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "git-cliff": "^2.10.1",
    "globals": "^17.7.0",
    "happy-dom": "^18.0.1",
    "node-abi": "^4.31.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "unocss": "^66.7.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "multer": "^2.0.2",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0",
    "vue": "^3.5.35"
  }
}
