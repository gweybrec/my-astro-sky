# Copy this file to .env and fill in your values.
# In the Electron desktop app, use the Settings panel instead — .env is not packaged.

# ── Plate solver / API ─────────────────────────────────────────────────────────
# astrometry.net API key (https://nova.astrometry.net/api_help)
# Can also be set at runtime via the Settings panel (stored in the local DB).
ASTROMETRY_API_KEY=

# ── Star catalog ───────────────────────────────────────────────────────────────
# stars.14.json (~118k stars, 14.7 MB, committed) — covers sparse fields and galaxies
STAR_CATALOG_PATH=public/data/stars.14.json

# ── Server ─────────────────────────────────────────────────────────────────────
# PORT=3001
